<Project>
  <PropertyGroup>
    <ColibriVersionFile>$(MSBuildThisFileDirectory)VERSION</ColibriVersionFile>
    <ColibriVersionText Condition="Exists('$(ColibriVersionFile)')">$([System.IO.File]::ReadAllText('$(ColibriVersionFile)'))</ColibriVersionText>
    <ColibriVersion>$(ColibriVersionText.Trim())</ColibriVersion>
    <Version>$(ColibriVersion)</Version>
    <VersionPrefix>$(ColibriVersion)</VersionPrefix>
    <AssemblyVersion>$(ColibriVersion).0</AssemblyVersion>
    <FileVersion>$(ColibriVersion).0</FileVersion>
    <InformationalVersion>$(ColibriVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets Linux and macOS (CI) build and publish the Windows target frameworks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <Target Name="ValidateColibriVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ColibriVersionFile)')" Text="Root VERSION is required." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ColibriVersionText)', '\A(0|[1-9][0-9]{0,4})\.(0|[1-9][0-9]{0,4})\.(0|[1-9][0-9]{0,4})(\r?\n)?\z'))" Text="VERSION must be a canonical numeric major.minor.patch triple." />
    <Error Condition="$([System.Version]::Parse('$(ColibriVersion)').Major) &gt; 65534 Or $([System.Version]::Parse('$(ColibriVersion)').Minor) &gt; 65534 Or $([System.Version]::Parse('$(ColibriVersion)').Build) &gt; 65534" Text="VERSION components must not exceed 65534." />
    <Error Condition="'$(Version)' != '$(ColibriVersion)' Or '$(VersionPrefix)' != '$(ColibriVersion)' Or '$(AssemblyVersion)' != '$(ColibriVersion).0' Or '$(FileVersion)' != '$(ColibriVersion).0' Or '$(InformationalVersion)' != '$(ColibriVersion)' Or '$(IncludeSourceRevisionInInformationalVersion)' != 'false'" Text="Product version overrides are forbidden; edit root VERSION." />
  </Target>

  <!--
    Target framework shared by Colibri.App and Colibri.App.Tests.
    Windows builds use the Windows TFM so the app can reach WinRT APIs (toast
    notifications) through Colibri.Platform. Linux and macOS builds use plain
    net10.0, because the Windows TFM pulls in Windows-only assets they cannot use.
    The Windows TFM is chosen when targeting a win-* runtime, or when no runtime
    is given and the build itself runs on Windows.
  -->
  <PropertyGroup>
    <ColibriAppTfm>net10.0</ColibriAppTfm>
    <ColibriAppTfm Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</ColibriAppTfm>
    <ColibriAppTfm Condition="$(RuntimeIdentifier.StartsWith('win'))">net10.0-windows10.0.19041.0</ColibriAppTfm>
  </PropertyGroup>
</Project>
