<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Colibri.App.ViewModels"
             xmlns:res="using:Colibri.App.Resources"
             x:Class="Colibri.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <!-- A label and its control: close together, and further from the next pair (card spacing). -->
        <Style Selector="StackPanel.field">
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Width" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="ListBox.settingsNav">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.settingsNav ListBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="SettingsGrid" ColumnDefinitions="170,*" RowDefinitions="Auto,*" Margin="16,8,16,16" ColumnSpacing="16" RowSpacing="10">
        <ComboBox x:Name="PageSelector" Grid.Column="1" ItemsSource="{Binding PageNames}"
                  SelectedIndex="{Binding SelectedPageIndex}" HorizontalAlignment="Stretch" IsVisible="False"
                  AutomationProperties.Name="{x:Static res:Strings.SettingsPageNavigation}" />
        <ListBox x:Name="PageNavigation" Grid.RowSpan="2" Classes="settingsNav" ItemsSource="{Binding PageNames}"
                 SelectedIndex="{Binding SelectedPageIndex}" VerticalAlignment="Top"
                 AutomationProperties.Name="{x:Static res:Strings.SettingsPageNavigation}" />
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsSavedAutomatically}" />
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="GeneralPage" IsVisible="{Binding IsGeneralPage}">
                    <StackPanel Spacing="10" Margin="0,0,8,8" MaxWidth="820" HorizontalAlignment="Stretch">
                        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsGeneral}" />
                        <Border Classes="card" IsVisible="{Binding HasUpdatesService}">
                            <StackPanel Spacing="8" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
                                <TextBlock Classes="section" Text="{x:Static res:Strings.UpdateHeading}" />
                                <TextBlock Text="{x:Static res:Strings.UpdateInstalledVersion}" />
                                <TextBlock Text="{Binding CurrentVersion}" AutomationProperties.Name="{x:Static res:Strings.UpdateInstalledVersion}" />
                                <CheckBox IsChecked="{Binding AutoCheckUpdates}">
                                    <TextBlock Text="{x:Static res:Strings.UpdateAutomaticChecks}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AvailableVersion}" IsVisible="{Binding HasUpdate}" AutomationProperties.Name="{x:Static res:Strings.UpdateAvailableVersion}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="CheckUpdateButton" Content="{x:Static res:Strings.UpdateCheckNow}" Command="{Binding CheckNowCommand}" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.UpdateDownload}" Command="{Binding DownloadCommand}" IsVisible="{Binding SupportsPackages}" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.UpdateCancel}" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" Margin="0,0,8,8" />
                                    <Button Content="{x:Static res:Strings.UpdateReveal}" Command="{Binding RevealCommand}" Margin="0,0,8,8" />
                                    <Button x:Name="InstallUpdateButton" Content="{x:Static res:Strings.UpdateInstall}" Command="{Binding InstallCommand}" IsVisible="{Binding IsInstalled}" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Classes="note" Text="{Binding PackageInstructions}" IsVisible="{Binding SupportsPackages}" />
                                <TextBlock Classes="note" Text="{x:Static res:Strings.UpdateOtherPlatforms}" IsVisible="{Binding !SupportsPackages}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <CheckBox IsChecked="{Binding StartWithSystem}" IsEnabled="{Binding IsAutostartSupported}"
                                          AutomationProperties.Name="{x:Static res:Strings.SettingsStartWithSystem}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsStartWithSystem}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsAutostartUnsupported}" IsVisible="{Binding !IsAutostartSupported}" />
                                <CheckBox IsChecked="{Binding AutoOpenDetailsWindow}" AutomationProperties.Name="{x:Static res:Strings.SettingsAutoOpenDetails}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsAutoOpenDetails}" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="CloseToTrayBox" IsChecked="{Binding CloseToTray}" IsEnabled="{Binding IsTrayAvailable}"
                                          AutomationProperties.Name="{x:Static res:Strings.SettingsCloseToTray}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsCloseToTray}" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding MinimizeToTray}" IsEnabled="{Binding IsTrayAvailable}"
                                          AutomationProperties.Name="{x:Static res:Strings.SettingsMinimizeToTray}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsMinimizeToTray}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsTrayUnavailable}" IsVisible="{Binding !IsTrayAvailable}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AppearancePage" IsVisible="{Binding IsAppearancePage}">
                    <StackPanel Spacing="10" Margin="0,0,8,8" MaxWidth="820" HorizontalAlignment="Stretch">
                        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsAppearance}" />
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsLanguage}" />
                                    <ComboBox x:Name="LanguageBox" ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex}" MinWidth="200"
                                              AutomationProperties.Name="{x:Static res:Strings.SettingsLanguage}" />
                                    <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsLanguageRestart}" TextWrapping="Wrap"
                                               IsVisible="{Binding IsLanguageRestartRequired}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsTheme}" />
                                    <ComboBox x:Name="ThemeBox" ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" MinWidth="200"
                                              AutomationProperties.Name="{x:Static res:Strings.SettingsTheme}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsPalette}" />
                                    <ComboBox x:Name="PaletteBox" ItemsSource="{Binding PaletteNames}" SelectedIndex="{Binding PaletteIndex}" MinWidth="200"
                                              AutomationProperties.Name="{x:Static res:Strings.SettingsPalette}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsAccent}" />
                                    <ComboBox ItemsSource="{Binding AccentNames}" SelectedIndex="{Binding AccentIndex}" MinWidth="200"
                                              AutomationProperties.Name="{x:Static res:Strings.SettingsAccent}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsLayoutHint}" />
                                    <Button x:Name="SettingsLayoutButton" Content="{x:Static res:Strings.LayoutMenu}"
                                            Click="OnLayoutClick" HorizontalAlignment="Left"
                                            ToolTip.Tip="{x:Static res:Strings.LayoutMenu}" AutomationProperties.Name="{x:Static res:Strings.LayoutMenu}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DownloadsPage" IsVisible="{Binding IsDownloadsPage}">
                    <StackPanel Spacing="10" Margin="0,0,8,8" MaxWidth="820" HorizontalAlignment="Stretch">
                        <!-- Downloads -->
                        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsDownloads}" />
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsDefaultFolder}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <!-- Text boxes save when they lose focus, not on every key press. -->
                                        <TextBox x:Name="DefaultFolderBox" Text="{Binding DefaultFolder, UpdateSourceTrigger=LostFocus}"
                                                 PlaceholderText="{Binding DefaultFolderPlaceholder}"
                                                 AutomationProperties.Name="{x:Static res:Strings.SettingsDefaultFolder}" />
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Browse}" Click="OnBrowseDefaultFolder" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsCategoryFolders}" />
                                    <ItemsControl ItemsSource="{Binding CategoryFolders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CategoryFolderViewModel">
                                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.ColumnSpan="3" Text="{Binding Label}" Margin="0,0,0,4" />
                                                    <TextBox Grid.Row="1" Text="{Binding Folder, UpdateSourceTrigger=LostFocus}"
                                                             PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Label}" />
                                                    <Button Grid.Row="1" Grid.Column="1" Content="{x:Static res:Strings.Browse}" Click="OnBrowseCategoryFolder" />
                                                    <Button Grid.Row="1" Grid.Column="2" Content="{x:Static res:Strings.SettingsUseDefault}" Command="{Binding UseDefaultCommand}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding FolderError}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap"
                                               IsVisible="{Binding FolderError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>

                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsMaxConcurrent}" />
                                    <NumericUpDown Value="{Binding MaxConcurrentDownloads}" Minimum="1" Maximum="20" Increment="1" FormatString="0"
                                                   AutomationProperties.Name="{x:Static res:Strings.SettingsMaxConcurrent}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsConnections}" />
                                    <NumericUpDown x:Name="ConnectionsBox" Value="{Binding ConnectionsPerServer}" Minimum="1" Maximum="16" Increment="1" FormatString="0"
                                                   AutomationProperties.Name="{x:Static res:Strings.SettingsConnections}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsSpeedLimit}" />
                                    <NumericUpDown Value="{Binding SpeedLimitKiB}" Minimum="0" Maximum="10000000" Increment="100" FormatString="0"
                                                   AutomationProperties.Name="{x:Static res:Strings.SettingsSpeedLimit}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="BrowserPage" IsVisible="{Binding IsBrowserPage}">
                    <StackPanel Spacing="10" Margin="0,0,8,8" MaxWidth="820" HorizontalAlignment="Stretch">
                        <!-- Browser -->
                        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsBrowserIntegration}" />
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="8" IsVisible="{Binding IsBrowserStatusVisible}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsBrowserStatus}" />
                                    <TextBlock Classes="note" Text="{x:Static res:Strings.SettingsBrowserHint}" />
                                    <ItemsControl x:Name="BrowserStatusList" ItemsSource="{Binding BrowserStatuses}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BrowserStatusViewModel">
                                                <Grid ColumnDefinitions="160,*">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="note" Text="{x:Static res:Strings.BrowserNoneFound}" IsVisible="{Binding NoBrowserFound}" />
                                    <Button x:Name="InstallBrowserButton" Content="{x:Static res:Strings.SettingsBrowserInstall}"
                                            Command="{Binding InstallBrowserIntegrationCommand}" />
                                    <TextBlock Text="{Binding BrowserError}" Foreground="{DynamicResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap"
                                               IsVisible="{Binding BrowserError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsCaptureExtensions}" />
                                    <TextBox Text="{Binding CaptureExtensions, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                                             AutomationProperties.Name="{x:Static res:Strings.SettingsCaptureExtensions}" />
                                </StackPanel>
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsCaptureMinSize}" />
                                    <NumericUpDown Value="{Binding CaptureMinSizeKiB}" Minimum="0" Maximum="2147483647" Increment="100" FormatString="0"
                                                   AutomationProperties.Name="{x:Static res:Strings.SettingsCaptureMinSize}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="AdvancedPage" IsVisible="{Binding IsAdvancedPage}">
                    <StackPanel Spacing="10" Margin="0,0,8,8" MaxWidth="820" HorizontalAlignment="Stretch">
                        <!-- Advanced -->
                        <TextBlock Classes="section" Text="{x:Static res:Strings.SettingsAdvanced}" />
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <StackPanel Classes="field">
                                    <TextBlock Text="{x:Static res:Strings.SettingsAria2Path}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding Aria2Path, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.Name="{x:Static res:Strings.SettingsAria2Path}" />
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Browse}" Click="OnBrowseAria2" />
                                    </Grid>
                                </StackPanel>
                                <Button Content="{x:Static res:Strings.SettingsOpenLogs}" Command="{Binding OpenLogsFolderCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
