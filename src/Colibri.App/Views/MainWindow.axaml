<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Colibri.App.ViewModels"
        xmlns:res="using:Colibri.App.Resources"
        xmlns:conv="using:Colibri.App.Converters"
        x:Class="Colibri.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppName}"
        Width="1180" Height="700" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:IconKeyConverter x:Key="IconKey" />
    </Window.Resources>

    <Window.Styles>
        <!-- Surfaces. IWindowChrome adds the "mica" class when the Mica backdrop is active and "extended"
             when the content reaches into the title bar (see Services/WindowChrome.cs). -->
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.contentPane">
            <Setter Property="Background" Value="{DynamicResource ContentPaneBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="CornerRadius" Value="8,0,0,0" />
        </Style>
        <Style Selector=":is(Window).mica Border.contentPane">
            <Setter Property="Background" Value="{DynamicResource ContentPaneMicaBrush}" />
        </Style>
        <Style Selector="Border.titleBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).extended Border.titleBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Command bar: icon above a short label. -->
        <Style Selector="Button.command">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.command:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.command PathIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="Button.command TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Rectangle.commandSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,10" />
            <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
        </Style>

        <!-- Navigation pane: a subtle highlight for the selected entry, as in Windows 11's own apps. -->
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>

        <!-- Table: compact rows on the pane's own background. -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Space for the title bar when the content is extended into it (Windows). Avalonia draws the
             title text and the caption buttons on top; this row keeps the content below them and is
             a drag area for moving the window. -->
        <Border Grid.Row="0" Classes="titleBar" Height="32" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />

        <!-- Command bar. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,2,14,8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="command" Command="{Binding AddUrlCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandAddUrl}" HotKey="Ctrl+N">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconAdd}" />
                        <TextBlock Text="{x:Static res:Strings.CommandAddUrl}" />
                    </StackPanel>
                </Button>
                <Rectangle Classes="commandSeparator" />
                <Button Classes="command" Command="{Binding ResumeCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandResume}">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconResume}" />
                        <TextBlock Text="{x:Static res:Strings.CommandResume}" />
                    </StackPanel>
                </Button>
                <Button Classes="command" Command="{Binding PauseCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandPause}">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconPause}" />
                        <TextBlock Text="{x:Static res:Strings.CommandPause}" />
                    </StackPanel>
                </Button>
                <Button Classes="command" Command="{Binding PauseAllCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandPauseAll}">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconPauseAll}" />
                        <TextBlock Text="{x:Static res:Strings.CommandPauseAll}" />
                    </StackPanel>
                </Button>
                <Rectangle Classes="commandSeparator" />
                <Button Classes="command" Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandDelete}">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconDelete}" />
                        <TextBlock Text="{x:Static res:Strings.CommandDelete}" />
                    </StackPanel>
                </Button>
                <Rectangle Classes="commandSeparator" />
                <Button Classes="command" Command="{Binding SettingsCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.CommandSettings}">
                    <StackPanel>
                        <PathIcon Data="{StaticResource IconSettings}" />
                        <TextBlock Text="{x:Static res:Strings.CommandSettings}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBox Grid.Column="1" Width="260" VerticalAlignment="Center"
                     PlaceholderText="{x:Static res:Strings.SearchPlaceholder}"
                     AutomationProperties.Name="{x:Static res:Strings.SearchPlaceholder}"
                     Text="{Binding SearchText}">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" Opacity="0.7" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="210,*">

            <!-- Navigation pane. The "Categories" title is a disabled (unselectable) entry. -->
            <ListBox x:Name="NavList" Classes="nav" Background="Transparent"
                     ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:NavItemViewModel">
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavItemViewModel">
                        <Panel>
                            <TextBlock IsVisible="{Binding IsHeader}" Text="{Binding Label}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <Grid IsVisible="{Binding IsSelectable}" ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                          Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Classes="contentPane" ClipToBounds="True">
                <Panel>
                    <!-- The DataGrid only creates rows that are on screen (row virtualization is built in). -->
                    <DataGrid x:Name="DownloadsGrid"
                              ItemsSource="{Binding Downloads}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" CanUserSortColumns="True"
                              CanUserResizeColumns="True" CanUserReorderColumns="True"
                              RowHeight="32" GridLinesVisibility="None" HeadersVisibility="Column"
                              SelectionChanged="OnGridSelectionChanged"
                              DoubleTapped="OnGridDoubleTapped">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static res:Strings.MenuOpen}" Command="{Binding OpenCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconOpen}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuShowInFolder}" Command="{Binding ShowInFolderCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderOpen}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuCopyUrl}" Command="{Binding CopyUrlCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconCopy}" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.CommandResume}" Command="{Binding ResumeCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconResume}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.CommandPause}" Command="{Binding PauseCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconPause}" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static res:Strings.CommandDelete}" Command="{Binding DeleteCommand}">
                                    <MenuItem.Icon><PathIcon Data="{StaticResource IconDelete}" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static res:Strings.MenuDeleteWithFile}" Command="{Binding DeleteWithFileCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnFileName}"
                                                    SortMemberPath="FileName" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*" Margin="12,0,8,0" Background="Transparent"
                                              ToolTip.Tip="{Binding ErrorMessage}">
                                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                      Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:DataType="vm:DownloadItemViewModel"
                                                Header="{x:Static res:Strings.ColumnSize}"
                                                Binding="{Binding SizeText}" SortMemberPath="TotalBytes" Width="100" />

                            <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnProgress}"
                                                    SortMemberPath="ProgressValue" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                        <Grid ColumnDefinitions="*,118" Margin="12,0,8,0">
                                            <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100"
                                                         MinWidth="40" MinHeight="4" Height="4" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="10,0,0,0"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:DataType="vm:DownloadItemViewModel"
                                                Header="{x:Static res:Strings.ColumnSpeed}"
                                                Binding="{Binding SpeedText}" SortMemberPath="Speed" Width="110" />
                            <DataGridTextColumn x:DataType="vm:DownloadItemViewModel"
                                                Header="{x:Static res:Strings.ColumnTimeLeft}"
                                                Binding="{Binding TimeLeftText}" SortMemberPath="SecondsLeft" Width="110" />
                            <DataGridTextColumn x:DataType="vm:DownloadItemViewModel"
                                                Header="{x:Static res:Strings.ColumnDateAdded}"
                                                Binding="{Binding AddedText}" SortMemberPath="AddedAt" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Shown when aria2c cannot be found. -->
                    <Border IsVisible="{Binding IsEngineMissing}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="560" Margin="24" Padding="24" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20"
                                          Foreground="{DynamicResource WarningIconBrush}" />
                                <TextBlock Text="{x:Static res:Strings.EngineMissingTitle}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.EngineMissingBody}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <StackPanel.Styles>
                                    <Style Selector="SelectableTextBlock">
                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
                                        <Setter Property="FontSize" Value="12" />
                                    </Style>
                                </StackPanel.Styles>
                                <SelectableTextBlock Text="{x:Static res:Strings.EngineMissingDebian}" />
                                <SelectableTextBlock Text="{x:Static res:Strings.EngineMissingFedora}" />
                                <SelectableTextBlock Text="{x:Static res:Strings.EngineMissingArch}" />
                                <SelectableTextBlock Text="{x:Static res:Strings.EngineMissingOpenSuse}" />
                                <SelectableTextBlock Text="{x:Static res:Strings.EngineMissingMac}" />
                            </StackPanel>
                            <Button Classes="accent" Content="{x:Static res:Strings.EngineRetry}"
                                    Command="{Binding RetryEngineCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Panel>
            </Border>
        </Grid>

        <!-- Status bar. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="28" Margin="16,5">
            <StackPanel.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                </Style>
            </StackPanel.Styles>
            <TextBlock Text="{Binding SpeedText}" />
            <TextBlock Text="{Binding ActiveText}" />
            <TextBlock Text="{Binding EngineStateText}" />
        </StackPanel>
    </Grid>
</Window>
