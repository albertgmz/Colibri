<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Colibri.App.ViewModels"
        xmlns:res="using:Colibri.App.Resources"
        xmlns:q="using:Colibri.Core.Queues"
        x:Class="Colibri.App.Views.AddUrlWindow"
        x:DataType="vm:AddUrlViewModel"
        Title="{x:Static res:Strings.AddUrlTitle}"
        Width="580" SizeToContent="Height" CanResize="False" CanMinimize="False"
        Background="{DynamicResource ChromeBackgroundBrush}">
    <!-- A dialog: no minimize or maximize button (Windows then hides both), and the main window's surface color. -->

    <StackPanel Margin="24,20" Spacing="18">
        <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="10">
            <Grid.Styles>
                <Style Selector="Label">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Styles>

            <Label Grid.Row="0" Content="{x:Static res:Strings.AddUrlUrlLabel}" Target="UrlBox" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="UrlBox" Text="{Binding Url}"
                     AutomationProperties.Name="{x:Static res:Strings.AddUrlUrlLabel}" />

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ErrorText}" TextWrapping="Wrap"
                       Foreground="{DynamicResource ErrorTextBrush}" FontSize="12"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Label Grid.Row="2" Content="{x:Static res:Strings.AddUrlFileNameLabel}" Target="FileNameBox" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FileNameBox" Text="{Binding FileName}"
                     AutomationProperties.Name="{x:Static res:Strings.AddUrlFileNameLabel}" />

            <Label Grid.Row="3" Content="{x:Static res:Strings.AddUrlFolderLabel}" Target="FolderBox" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="FolderBox" Text="{Binding SaveFolder}"
                     AutomationProperties.Name="{x:Static res:Strings.AddUrlFolderLabel}" />
            <Button Grid.Row="3" Grid.Column="2" Content="{x:Static res:Strings.AddUrlBrowse}" Click="OnBrowseClick" />

            <Label Grid.Row="4" Content="{x:Static res:Strings.AddUrlSizeLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" />
        </Grid>

        <ComboBox ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="{x:Static res:Strings.QueuesTitle}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="q:DownloadQueue"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Border IsVisible="{Binding IsDuplicatePrompt}" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.DuplicateUrlPrompt}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.CommandResume}" Command="{Binding ResumeDuplicateCommand}" />
                    <Button Content="{x:Static res:Strings.DuplicateRedownload}" Command="{Binding RedownloadDuplicateCommand}" />
                    <Button Content="{x:Static res:Strings.DuplicateRename}" Command="{Binding RenameDuplicateCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button IsVisible="{Binding IsBrowserCapture}" Content="{x:Static res:Strings.BrowserFallback}"
                    Command="{Binding BrowserFallbackCommand}" />
            <!-- IsDefault: Enter presses it. IsCancel: Esc presses Cancel. -->
            <Button Classes="accent" MinWidth="110" IsDefault="True"
                    IsVisible="{Binding !IsDuplicatePrompt}"
                    Content="{x:Static res:Strings.AddUrlDownload}" Command="{Binding DownloadCommand}" />
            <Button MinWidth="110" IsCancel="True"
                    Content="{x:Static res:Strings.AddUrlCancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
