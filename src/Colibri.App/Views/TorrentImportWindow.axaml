<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Colibri.App.ViewModels" xmlns:res="using:Colibri.App.Resources" xmlns:q="using:Colibri.Core.Queues"
        x:Class="Colibri.App.Views.TorrentImportWindow" x:DataType="vm:TorrentImportViewModel"
        Title="{x:Static res:Strings.TorrentImport}" Width="720" Height="680" MinWidth="520" MinHeight="420"
        Background="{DynamicResource ChromeBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="12">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Static res:Strings.TorrentSource}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Source}" TextWrapping="Wrap" MaxHeight="70" />
                <TextBlock Text="{x:Static res:Strings.TorrentMetadataHelp}" TextWrapping="Wrap" IsVisible="{Binding IsMagnet}" />
                <Button Content="{x:Static res:Strings.TorrentFetchMetadata}" Command="{Binding FetchMetadataCommand}" IsVisible="{Binding IsMagnet}" />
                <StackPanel IsVisible="{Binding HasMetadata}" Spacing="10">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding InfoHash}" FontFamily="monospace" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static res:Strings.TorrentPrivate}" IsVisible="{Binding IsPrivate}" />
                    <TextBlock Text="{x:Static res:Strings.TorrentDestination}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding IsNewDownload}">
                        <TextBox Grid.Column="0" Text="{Binding SaveFolder}" AutomationProperties.Name="{x:Static res:Strings.TorrentDestination}" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.TorrentBrowse}" Click="OnBrowseClick" />
                    </Grid>
                    <TextBlock Text="{x:Static res:Strings.QueuesTitle}" />
                    <ComboBox ItemsSource="{Binding Queues}" SelectedItem="{Binding SelectedQueue}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="q:DownloadQueue"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{x:Static res:Strings.TorrentFiles}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{x:Static res:Strings.TorrentSelectAll}" Command="{Binding SelectAllCommand}" />
                        <Button Grid.Column="2" Content="{x:Static res:Strings.TorrentSelectNone}" Command="{Binding SelectNoneCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Files}" Height="170" SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TorrentFileChoice">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Static res:Strings.TorrentSelectedSize}" />
                        <TextBlock Text="{Binding SelectedSize}" FontWeight="SemiBold" />
                    </StackPanel>
                    <CheckBox Content="{x:Static res:Strings.TorrentSeedEnabled}" IsChecked="{Binding SeedAfterCompletion}" />
                    <TextBlock Text="{x:Static res:Strings.TorrentSeedHelp}" TextWrapping="Wrap" Opacity="0.75" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Text="{x:Static res:Strings.TorrentSeedRatio}" />
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.TorrentSeedMinutes}" />
                        <NumericUpDown Grid.Row="1" Value="{Binding SeedRatio}" Minimum="0.1" Maximum="100" Increment="0.1" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SeedMinutes}" Minimum="1" Maximum="10080" FormatString="0" />
                        <TextBlock Grid.Row="2" Text="{x:Static res:Strings.TorrentUploadLimit}" />
                        <NumericUpDown Grid.Row="3" Value="{Binding UploadLimitKiB}" Minimum="1" Maximum="65536" FormatString="0" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="{x:Static res:Strings.TorrentUploaded}" />
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.TorrentUploadSpeed}" />
                        <TextBlock Grid.Row="1" Text="{Binding Uploaded}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UploadSpeed}" />
                    </Grid>
                    <Button Content="{x:Static res:Strings.TorrentStopSeeding}" Command="{Binding StopSeedingCommand}" IsVisible="{Binding IsSeeding}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding ConfirmLabel}" Command="{Binding ImportCommand}" />
            <Button Content="{x:Static res:Strings.TorrentCancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
