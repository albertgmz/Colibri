<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Colibri.App.Views"
        x:Class="Colibri.App.Views.DownloadDetailsWindow"
        Width="660" Height="430" MinWidth="440" MinHeight="300">
    <Window.Styles>
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource ChromeBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.detailsSurface">
            <Setter Property="Background" Value="{DynamicResource ContentPaneBrush}" />
        </Style>
        <Style Selector=":is(Window).mica Border.detailsSurface">
            <Setter Property="Background" Value="{DynamicResource ContentPaneMicaBrush}" />
        </Style>
        <Style Selector="Border.titleBar">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).extended Border.titleBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*">
        <Border Classes="titleBar" Height="32" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />
        <Border x:Name="DetailsSurface" Grid.Row="1" Classes="detailsSurface" Padding="12"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
            <views:DownloadDetailsView x:Name="DetailsContent" CanPopOut="False" />
        </Border>
    </Grid>
</Window>
